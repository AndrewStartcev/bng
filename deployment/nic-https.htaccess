# Insert before WordPress-generated rules, only on NIC client hosting.
# NIC passes the original TLS state through ENV:HTTPS.
# https://www.nic.ru/help/fajl-htaccess-nastrojka-perenapravlenij-i-upravlenie-konfiguraciej-veb-servera_6793.html
# BEGIN BNG HTTPS
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{ENV:HTTPS} !on
RewriteCond %{HTTP_HOST} ^(?:www\.)?(bng-elements\.(?:ru|com))$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>
# END BNG HTTPS
